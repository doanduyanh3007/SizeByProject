# Backend API Configuration
# Copy this file to .env.local and update the API URL to match your backend host

# API Base URL - Change this to your backend server address
# Examples:
# VITE_API_URL=http://localhost:8080/api (Local development)
# VITE_API_URL=http://192.168.1.100:8080/api (Local network)
# VITE_API_URL=https://api.example.com/api (Production)

VITE_API_URL=http://localhost:8080/api

# App Name
VITE_APP_NAME=SizeBy Shop

# Environment
VITE_ENVIRONMENT=development
